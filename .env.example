# Frontend URL
FRONT_URL=http://localhost:3003

# MongoDB
MONGODB_URI=mongodb://your-user:your-password@your-host/
MONGODB_DATABASE=woco-docs

# Session
SESSION_SECRET=generate-a-64-char-hex-string
# Sliding session idle-timeout in days (default 7). The DB session is the real
# source of truth: it slides forward on each authenticated request, so an
# active session never expires; only an idle one is reaped after this many days.
SESSION_TTL_DAYS=7
# JWT signature lifetime (default 30d). Must be LONGER than SESSION_TTL_DAYS so
# the JWT never expires before the DB session — otherwise /auth/me hard-fails
# and forces re-login regardless of activity. ms-style duration: "30d", "12h".
JWT_EXPIRES_IN=30d

# Encryption (AES-256-GCM - 32 bytes hex)
ENCRYPTION_KEY=generate-a-64-char-hex-string

# App
PORT=3000

# AI-VARS
ORCHESTRA_URL=http://localhost:8001

# Local file storage — where uploaded images are written and served from
# (/uploads/*). Optional; defaults to <cwd>/uploads. Point at a persistent
# volume in production so uploads survive redeploys.
# UPLOADS_DIR=/var/lib/wocobot/uploads
